# Supabase — required for video data and email sign-ups
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL used for Open Graph and sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://map.defendbigbend.com

# Analytics — set to your Plausible domain to enable (leave blank to disable)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
